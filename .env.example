# CircuScan Environment Variables Template

# 1. Google Gemini API Key (REQUIRED for LLM + Vision AI + Diagnostic questions)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server Port (Optional, defaults to 8000. Set automatically by Render/Railway)
PORT=8000

# 3. Next.js API Base URL (Optional - leave empty for single-container deployment)
# Set this ONLY if deploying Next.js frontend on Vercel separately from FastAPI backend.
# NEXT_PUBLIC_API_BASE=https://your-backend-app.onrender.com
